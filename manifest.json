{
    "manifest_version": 3,
    "name": "Website Blockerinator",
    "version": "0.1.0",
    "description": "A Chrome extension that blocks websites.",
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "blocker_rules",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}